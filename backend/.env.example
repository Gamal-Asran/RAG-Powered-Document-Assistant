APP_NAME=NIST AI Risk Assistant
APP_ENV=development
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=1024
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHROMA_PATH=backend/data/vector_store
CHROMA_COLLECTION=nist_ai_risk_corpus
RETRIEVAL_TOP_K=4
MAX_HISTORY_EXCHANGES=2
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:7860,http://127.0.0.1:7860
